# fastlane on this Mac: copy to fastlane/.env (ignored by git), or run
#   make asc-env P8=~/chemin/AuthKey_XXXXXXXXXX.p8 KEY_ID=XXXXXXXXXX ISSUER=xxxxxxxx-xxxx-…
# then add the match values by hand. fastlane reads fastlane/.env by itself.

# App Store Connect API key (Utilisateurs et accès › Intégrations), role Admin
ASC_KEY_ID=
ASC_ISSUER_ID=
# the .p8 file, in base64 on one line
ASC_KEY_P8=

# fastlane match: a PRIVATE git repository for the certificates and profiles,
# and the password that encrypts them (keep it in a password manager)
MATCH_GIT_URL=
MATCH_PASSWORD=
