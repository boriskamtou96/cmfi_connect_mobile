<?xml version="1.0" encoding="utf-8"?>
<!-- The "Verset du jour" widget: like the verse card of the app (a warm
     paper, the brand blue, a touch of gold). The texts are the app's; these
     are for the preview in the launcher's list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verse_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:background="@drawable/verse_widget_mark" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/verse_widget_title"
            android:textAllCaps="true"
            android:textColor="@color/verse_widget_blue"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/verse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="4"
        android:text="@string/verse_widget_sample"
        android:textAlignment="textStart"
        android:textColor="@color/verse_widget_ink"
        android:textDirection="firstStrong"
        android:textSize="15sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/verse_widget_sample_reference"
        android:textAlignment="textStart"
        android:textColor="@color/verse_widget_muted"
        android:textDirection="firstStrong"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
