<?xml version="1.0" encoding="utf-8"?>
<!-- Dev flavor only: lets the app call the local API over plain HTTP
     (10.0.2.2 on the emulator, or the Mac's IP on a real phone).
     The prod flavor keeps Android's default: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
